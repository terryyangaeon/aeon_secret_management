# Copy to .env (git-ignored) for local DEV with docker compose.

# The app is reached at http://localhost:8094 either way: with docker compose
# the container listens on 8080 and is published as 8094; running `node server.js`
# directly it listens on 8094 itself.
# (8093 belongs to iotwa-dash — do not reuse it.)
PORT=8094

# Encrypts stored secret values. Set it once and never change it —
# changing it makes every stored secret value unreadable.
APP_SECRET=change-me

# Seeds one Email-type admin on the very first run (keep one as break-glass).
BOOTSTRAP_ADMIN_EMAIL=itdept@aeondelightasia.com
BOOTSTRAP_ADMIN_PASSWORD=

# Microsoft Entra ID — sign-in AND Microsoft Graph.
# Application permissions needed, with admin consent:
#   User.Read.All, Application.ReadWrite.OwnedBy, Mail.Send
SSO_TENANT_ID=56148049-8a41-4bce-93f6-47725ef85b5a
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=

# Keep the scheduler off in DEV so a DEV copy never rotates production secrets.
ROTATE_ENABLED=0

# Optional: supply the Coolify connection here instead of saving it in Configuration.
# The token needs read:sensitive + write + deploy (Coolify → Keys & Tokens → API Tokens).
COOLIFY_URL=https://coolify-kvm.aeondelightasia.online
COOLIFY_API_TOKEN=
